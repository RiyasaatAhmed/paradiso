# Copy this file to .env and edit it. Used by docker-compose.yml only.

# The folder holding your films. Everything inside it, three levels deep, gets
# scanned. Mount a parent folder if you keep films in several places.
PARADISO_MEDIA=/Users/you/Movies

# The port to open in your browser. Only change this if 8080 is already taken.
PARADISO_PORT=8080

# Your machine's address on your wifi, so the logs print a URL you can actually
# type into the TV. Find it with:
#   macOS:  ipconfig getifaddr en0
#   Linux:  hostname -I | awk '{print $1}'
# If you changed PARADISO_PORT above, include it here too: 192.168.0.106:9000
PARADISO_ANNOUNCE_HOST=192.168.0.106
